        0
      ],
      "parameters": {
        "jsCode": "// CloudChat team member who gets the desktop alert for chats assigned to her (the clinic: Rotem; this demo workspace has one member, Roey)\nconst ON_DUTY_AGENT_ID = 296139;\nconst i = $input.first().json;\nreturn [{ json: { raw_phone: i.raw_phone, tag: i.tag, agent_id: ON_DUTY_AGENT_ID } }];"
      }
    },
    {
      "id": "d4090a41-7d96-4bdb-bd70-ef96f629083b",
      "name": "CloudChat · איתור השיחה",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://console.thecloud.chat/api/subscribers?user_field_ns=f263073v17864389&user_field_value={{ encodeURIComponent($json.raw_phone) }}&limit=10",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "COecLlGgnMP2e7DQ",
          "name": "Roey - CloudChat API (אורה)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "6ee436be-c861-48bc-8b08-f0fc1ede5773",
      "name": "בחירת השיחה האחרונה",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// several test chats can share a phone: the conversation that is happening now has the latest interaction\nconst list = ($input.first().json.data || []).slice();\nlist.sort((a, b) => String(b.last_interaction || '').localeCompare(String(a.last_interaction || '')));\nreturn [{ json: { user_ns: list[0]?.user_ns || null } }];"
      }
    },
    {
      "id": "3c4f54d9-c789-45d8-96d7-b76488517244",
      "name": "CloudChat · פתיחת השיחה לנציגה",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://console.thecloud.chat/api/subscriber/move-chat-to",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ user_ns: $json.user_ns, status: 'open' }) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "COecLlGgnMP2e7DQ",
          "name": "Roey - CloudChat API (אורה)"
        }
      },
