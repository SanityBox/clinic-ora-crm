    {
      "id": "4d747180-8bdf-483f-960c-8c1b5f935900",
      "name": "בדיקת ההעברה",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "jsCode": "// a handoff nobody sees is a lost customer: any failed step is reported to the CRM dashboard\nconst steps = ['CloudChat · איתור השיחה', 'CloudChat · פתיחת השיחה לנציגה', 'CloudChat · תגית סיבה', 'CloudChat · שיוך לנציגה התורנית'];\nconst failed = steps.filter((s) => { const j = $(s).first().json; return j.error || (j.status && j.status !== 'ok'); });\nif (!$('בחירת השיחה האחרונה').first().json.user_ns) failed.unshift('לא נמצאה שיחה עם הטלפון');\nconst i = $('נציגה תורנית').first().json;\nif (!failed.length) return [{ json: { report: false } }];\nreturn [{ json: { report: true, p_source: 'העברה לנציגה ב-CloudChat', p_node: failed[0],\n  p_message: `ההעברה לנציגה נכשלה (${i.tag}). טלפון ${i.raw_phone}. צריך לחזור ללקוחה ידנית.`,\n  p_details: { failed, raw_phone: i.raw_phone, tag: i.tag } } }];"
      }
    },
