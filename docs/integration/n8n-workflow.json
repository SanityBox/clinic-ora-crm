      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        -140
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\n// Confirm only when the database returned a real ticket number (exam 5a: never report a ticket that was not created)\nif (r && r.ok === true && Number.isInteger(r.ticket_number)) {\n  return [{ json: { response: {\n    ok: true,\n    ticket_number: r.ticket_number,\n    ticket_id: r.ticket_id,\n    status: 'חדשה',\n    priority: r.priority === 'urgent' ? 'דחופה' : 'רגילה',\n    duplicate: r.duplicate === true,\n    customer_created: r.customer_created === true,\n    message: r.duplicate === true\n      ? 'הפנייה הזו כבר נשמרה קודם, מספר פנייה ' + r.ticket_number + '. אין לפתוח שוב.'\n      : 'הפנייה נשמרה ב-CRM. מספר פנייה ' + r.ticket_number + '.'\n  } } }];\n}\nconst messages = {\n  clinic_phone: 'זה מספר הטלפון של הקליניקה, לא של הלקוחה. יש לבקש מהלקוחה את מספר הטלפון שלה. הפנייה לא נשמרה.',\n  invalid_phone: 'מספר הטלפון לא תקין. יש לבקש מהלקוחה מספר ישראלי תקין. הפנייה לא נשמרה.',\n};\nreturn [{ json: { response: {\n  ok: false,\n  error: r?.error || 'crm_rejected',\n  message: messages[r?.error] || 'הפנייה לא נשמרה. אסור לומר ללקוחה שנפתחה פנייה.'\n} } }];"
      }
    },
