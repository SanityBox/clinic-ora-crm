        "jsCode": "const v = $input.first().json;\nreturn [{ json: { response: { ok: false, error: 'invalid_input', missing: v.missing || ['phone'], message: \"חסרים פרטים (שם, טלפון תקין או תיאור). הפנייה לא נשמרה.\" } } }];"
      }
    },
