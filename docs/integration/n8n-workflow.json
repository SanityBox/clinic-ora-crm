      ],
      "parameters": {
        "jsCode": "// Human handoff inside CloudChat (exam Q4-5, \"התראה לבן אדם\"): a saved human request, or a CRM failure that is not a input error\nconst r = $input.first().json.response || {};\nconst inp = $('בדיקת קלט · פנייה').first().json;\nconst inputErrors = ['invalid_phone', 'clinic_phone', 'missing_description', 'invalid_input'];\nlet tag = null;\nif (r.ok === true && inp.request_type === 'בקשת נציגה') tag = 'ביקשו נציגה';\nelse if (r.ok !== true && !inputErrors.includes(r.error)) tag = 'CRM נכשל - לטפל ידנית';\nreturn [{ json: { response: r, handoff: Boolean(tag && inp.raw_phone), tag, raw_phone: inp.raw_phone } }];"
      }
