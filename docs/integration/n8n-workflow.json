      "parameters": {
        "content": "## מסלול א · פתיחת קריאת שירות\nהסוכן שולח שם, טלפון ותיאור. Supabase מחפש לקוחה לפי טלפון (או יוצר), פותח קריאה בסטטוס **חדשה** ומחזיר מספר.\nתשובה עם `ok: true` רק אם חזר מספר קריאה אמיתי. כל כשל מחזיר `ok: false`, והסוכן לא מאשר.",
        "height": 220,
        "width": 1260,
        "color": 5
      }
    },
    {
      "id": "Webhook00",
      "name": "Webhook · פתיחת קריאה",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "roey-ora-create-ticket",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "LhQdbKRi7qwAQxCC",
          "name": "Roey - CloudChat webhook key"
        }
      },
      "webhookId": "6f1d2a40-0c55-4c2e-9b1e-0a0c4ea7e001"
    },
    {
      "id": "2200",
      "name": "בדיקת קלט · פנייה",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const toLocalPhone = (s) => {\n  let d = String(s ?? '').replace(/\\D/g, '');\n  if (d.startsWith('00972')) d = '0' + d.slice(5);\n  else if (d.startsWith('972')) d = '0' + d.slice(3);\n  return /^0(5|7)\\d{8}$/.test(d) || /^0[2-489]\\d{7}$/.test(d) ? d : null;\n};\nconst body = $input.first().json.body || {};\nconst name = String(body.name ?? '').trim();\nconst phone = toLocalPhone(body.phone);\nconst description = String(body.description ?? '').trim();\nconst missing = [];\nif (!name) missing.push('name');\nif (!phone) missing.push('phone');\nif (!description) missing.push('description');\nreturn [{ json: { valid: missing.length === 0, missing, name, phone, description, request_type: String(body.request_type ?? '').trim() } }];"
      }
    },
