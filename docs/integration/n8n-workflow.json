    {
      "id": "900420",
      "name": "תשובה · תור",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        420
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\n// PRD 10.2: only what is needed to answer, no name or therapist (the chat has no proof of identity)\nlet response;\nif (!r || r.ok !== true) {\n  response = { ok: false, error: r?.error || 'crm_error', message: 'לא ניתן לבדוק כרגע. אין לנחש תור.' };\n} else if (!r.customer_found) {\n  response = { ok: true, customer_found: false, has_appointment: false, message: 'לא נמצאה לקוחה עם מספר הטלפון הזה ברשומות.' };\n} else if (!r.has_appointment) {\n  response = { ok: true, customer_found: true, has_appointment: false, message: 'אין תור עתידי ברשומות שנבדקו.' };\n} else {\n  response = {\n    ok: true, customer_found: true, has_appointment: true,\n    weekday: r.weekday, date: r.date, time: r.time, treatment: r.treatment,\n    message: 'התור הבא: יום ' + r.weekday + ' ' + r.date + ' בשעה ' + r.time + ', ' + r.treatment\n  };\n}\nreturn [{ json: { response } }];"
      }
