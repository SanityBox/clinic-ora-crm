    {
      "id": "900420",
      "name": "תשובה · תור",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        420
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nlet response;\nif (!r || r.ok !== true) {\n  response = { ok: false, error: r?.error || 'crm_error', message: 'לא ניתן לבדוק כרגע. אין לנחש תור.' };\n} else if (!r.customer_found) {\n  response = { ok: true, customer_found: false, has_appointment: false, message: 'לא נמצאה לקוחה עם מספר הטלפון הזה ברשומות.' };\n} else if (!r.has_appointment) {\n  response = { ok: true, customer_found: true, has_appointment: false, first_name: r.first_name, message: 'אין תור עתידי ברשומות שנבדקו.' };\n} else {\n  response = {\n    ok: true, customer_found: true, has_appointment: true,\n    first_name: r.first_name, weekday: r.weekday, date: r.date, time: r.time,\n    treatment: r.treatment, therapist: r.therapist || null,\n    message: 'התור הבא: יום ' + r.weekday + ', ' + r.date + ' בשעה ' + r.time + ', ' + r.treatment + '.'\n  };\n}\nreturn [{ json: { response } }];"
      }
