    },
    {
      "id": "900-140",
      "name": "תשובה · פנייה",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        -140
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\n// Confirm only when the database returned a real ticket number (exam 5a: never report a ticket that was not created)\nif (r && r.ok === true && Number.isInteger(r.ticket_number)) {\n  return [{ json: { response: {\n    ok: true,\n    ticket_number: r.ticket_number,\n    ticket_id: r.ticket_id,\n    status: 'חדשה',\n    customer_created: r.customer_created === true,\n    message: 'הפנייה נשמרה ב-CRM. מספר פנייה ' + r.ticket_number + '.'\n  } } }];\n}\nreturn [{ json: { response: {\n  ok: false,\n  error: r?.error || 'crm_rejected',\n  message: 'הפנייה לא נשמרה. אסור לומר ללקוחה שנפתחה פנייה.'\n} } }];"
      }
    },
    {
      "id": "90020",
      "name": "כשל · פנייה",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        20
      ],
      "parameters": {
        "jsCode": "return [{ json: { response: { ok: false, error: 'crm_unreachable', message: \"ה-CRM לא זמין כרגע. הפנייה לא נשמרה. אסור לומר ללקוחה שנפתחה פנייה.\" } } }];"
      }
    },
